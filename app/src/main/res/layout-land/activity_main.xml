<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingVertical="16dp"
    android:paddingHorizontal="60dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="@color/white"
        android:gravity="center"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etLicensePlate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#00000000"
            android:hint="Kennzeichen"
            android:inputType="text"
            android:textAlignment="center" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:backgroundTint="@null"
            android:text="🔍"
            android:textSize="30dp" />

    </LinearLayout>

    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:visibility="gone"
        android:background="@drawable/rounded_corner">


        <TableRow >

            <TextView
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="Kennzeichen"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLicensePlate"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:textAlignment="center"
                android:textSize="16dp" />
        </TableRow>

        <TableRow android:background="@drawable/textlines" android:gravity="center">

            <TextView

                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="Marke"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvManufacture"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:textAlignment="center"
                android:textSize="16dp" />
        </TableRow>

        <TableRow android:background="@drawable/textlines" android:gravity="center">

            <TextView
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="Person"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPerson"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:textAlignment="center"
                android:textSize="16dp" />
        </TableRow>

        <TableRow android:background="@drawable/textlines" android:gravity="center">

            <TextView

                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="Einheit"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUnit"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:textAlignment="center"
                android:textSize="16dp" />
        </TableRow>

        <TableRow android:background="@drawable/textlines" android:gravity="center">

            <TextView
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:text="Elektrisch"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvElectric"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:textAlignment="center"
                android:textSize="16dp" />
        </TableRow>
    </TableLayout>
    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tableLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Kein Auto mit diesem Kennzeichen gefunden."
        android:textColor="@android:color/holo_red_dark"
        android:visibility="gone" />
</LinearLayout>
    <Button
        android:id="@+id/btnImport"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="30dp"
        android:background="@drawable/rounded_button"
        android:text="+"
        android:textSize="30dp" />
</RelativeLayout>